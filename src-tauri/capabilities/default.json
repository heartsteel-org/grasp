{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": ["core:window:default", "core:window:allow-start-dragging", "core:window:allow-close", "core:window:allow-minimize", "core:event:allow-listen", "core:event:allow-unlisten"]
}
